<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:wo="http://civicshield.com/workorder"
           targetNamespace="http://civicshield.com/workorder"
           elementFormDefault="qualified">

  <!-- SOAP header: carried on every request, same value as X-Correlation-Id -->
  <xs:element name="CorrelationId" type="xs:string"/>

  <xs:simpleType name="WorkOrderStatus">
    <xs:restriction base="xs:string">
      <xs:enumeration value="CREATED"/>
      <xs:enumeration value="IN_PROGRESS"/>
      <xs:enumeration value="COMPLETED"/>
      <xs:enumeration value="REJECTED"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Priority">
    <xs:restriction base="xs:string">
      <xs:enumeration value="LOW"/>
      <xs:enumeration value="MEDIUM"/>
      <xs:enumeration value="HIGH"/>
      <xs:enumeration value="URGENT"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="FaultCode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="INVALID_REQUEST"/>
      <xs:enumeration value="NOT_FOUND"/>
      <xs:enumeration value="SERVICE_UNAVAILABLE"/>
      <xs:enumeration value="INTERNAL_ERROR"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Latitude">
    <xs:restriction base="xs:double">
      <xs:minInclusive value="-90"/>
      <xs:maxInclusive value="90"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Longitude">
    <xs:restriction base="xs:double">
      <xs:minInclusive value="-180"/>
      <xs:maxInclusive value="180"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- CreateWorkOrder: idempotent on caseId. Sending the same caseId twice
       returns the same work order instead of creating a second one. -->
  <xs:element name="CreateWorkOrderRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="caseId" type="xs:string"/>
        <xs:element name="category" type="xs:string"/>
        <xs:element name="description" type="xs:string"/>
        <xs:element name="latitude" type="wo:Latitude"/>
        <xs:element name="longitude" type="wo:Longitude"/>
        <xs:element name="priority" type="wo:Priority"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="CreateWorkOrderResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="workOrderId" type="xs:string"/>
        <xs:element name="caseId" type="xs:string"/>
        <xs:element name="status" type="wo:WorkOrderStatus"/>
        <xs:element name="createdAt" type="xs:dateTime"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="GetWorkOrderStatusRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="workOrderId" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="GetWorkOrderStatusResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="workOrderId" type="xs:string"/>
        <xs:element name="status" type="wo:WorkOrderStatus"/>
        <xs:element name="lastUpdated" type="xs:dateTime"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Typed fault returned by both operations -->
  <xs:element name="WorkOrderFault">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="code" type="wo:FaultCode"/>
        <xs:element name="message" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>